{
    "norm_version": "1.0",
    "project_name": "client-core",
    "extends": "https://github.com/acme-foundation/acme.git#v3.2.0",
    "active_norm_scopes": [
        "norms/core/*",
        "norms/domain/ingestion/*",
        "norms/procedural/*"
    ],
    "upstream_dispatch": {
        "remote": "origin",
        "branch_template": "cases/{project_name}/CAS_{hex3}_{slug}",
        "auto_dispatch": true
    },
    "local_invariants": {
        "INV_TIMESTEP_01": "Fixed timestep dt=1/60s with sub-stepping clamp <=0.033s",
        "INV_ZERO_GC_02": "Pre-allocated object pools for entities/bullets/particles; hot path allocation=0",
        "INV_ASSET_INGEST_03": "Deterministic preload turnstile and stream quarantine",
        "INV_CONTROL_FSM_04": "Deterministic kinematic banking rig finite state machine",
        "INV_INCEPTION_RIGOR_05": "Zero implementation code during inception phase; scene topology documented in CAS file",
        "INV_AST_001_FIDELITY_TIER": "Production-grade Full HD (1920x1080) / HD (1280x720) canvas rendering. Zero crude placeholder primitives.",
        "INV_AST_002_REMAKE_PARADIGM": "Remake decoupling: Core mechanics derived from CPS-1 reference, visual/audio presentation target modern HD standards.",
        "INV_SPRITE_FIT_01": "Dual-axis bounding box confinement with mandatory safety padding (zero truncation).",
        "INV_CHROMA_ISOLATION_02": "High-contrast chroma key matting for zero white fringe artifact.",
        "INV_ORTHO_PERSPECTIVE_03": "Strict orthographic side elevation profile (Roll=0, Pitch=0, Yaw=0).",
        "INV_VISUAL_FIRST_DOC_04": "Mandatory visual artifact inspection gate before downstream integration."
    }
}
